<div class="space-y-4">
  <section class="rounded-md border border-stone-200 bg-white p-5">
    <div class="flex flex-wrap gap-2">
      <% [[t("admin.teachers.bulk.grade_tabs.all"), "all"], *1.upto(6).map { |grade| [t("admin.teachers.bulk.grade_tabs.grade", grade: grade), grade.to_s] }, [t("admin.teachers.bulk.grade_tabs.unassigned"), "unassigned"]].each do |label, grade| %>
        <%= link_to label,
              admin_teachers_path(@bulk_context_params.merge(grade: grade)),
              class: "rounded-md border px-3 py-2 text-sm font-medium #{@grade == grade ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white'}",
              data: { turbo_frame: "teacher_management", turbo_action: "advance" } %>
      <% end %>
    </div>

    <%= render "teachers/bulk_edit_table" %>
  </section>
</div>
