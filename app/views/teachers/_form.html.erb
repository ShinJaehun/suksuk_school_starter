<% teacher_avatar_keys = User.avatar_keys_for_role("teacher") %>
<% avatar_image_sources = teacher_avatar_keys.index_with { |avatar_key| asset_path("avatars/#{avatar_key}.png") } %>

<%= form_with model: @teacher,
      url: @teacher.persisted? ? teacher_path(@teacher) : teachers_path,
      class: "space-y-6",
      data: {
        turbo: (@teacher.persisted? ? nil : false),
        controller: "teacher-avatar-preview teacher-classroom-picker",
        teacher_classroom_picker_url_value: classroom_options_teachers_path,
        teacher_classroom_picker_selected_id_value: @selected_classroom_id,
        teacher_avatar_preview_male_keys_value: User::TEACHER_MALE_AVATAR_KEYS,
        teacher_avatar_preview_female_keys_value: User::TEACHER_FEMALE_AVATAR_KEYS,
        teacher_avatar_preview_all_keys_value: teacher_avatar_keys,
        teacher_avatar_preview_image_sources_value: avatar_image_sources
      } do |f| %>
  <% if @teacher.errors.any? %>
    <div class="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">
      <%= @teacher.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5"
           data-teacher-form-section="assignments">
    <h2 class="text-lg font-bold text-slate-900"><%= t("admin.teachers.school_assignment_title") %></h2>

    <% if @teacher_creation_school_year %>
      <p class="text-sm font-semibold text-slate-700">
        <%= t(
              "admin.teachers.form.school_year_context",
              school: @teacher_creation_school_year.school.name,
              year: @teacher_creation_school_year.year
            ) %>
      </p>
      <%= hidden_field_tag :school_id, @teacher_creation_school_year.school_id %>
      <%= hidden_field_tag :school_year_id, @teacher_creation_school_year.id %>
      <% unless @planning_teacher_creation %>
        <%= tag.input type: "hidden",
              value: @teacher_creation_school_year.school_id,
              data: { teacher_classroom_picker_target: "school" } %>
      <% end %>
    <% elsif @locked_classroom %>
      <p class="text-sm text-amber-700"><%= t("admin.teachers.form.inactive_classroom_assignment_locked") %></p>
      <dl class="grid gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="font-medium text-slate-500"><%= t("admin.teachers.form.school_label") %></dt>
          <dd class="mt-1 text-slate-900"><%= @locked_classroom.school_year.school.name %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-500"><%= t("filters.grade.label") %></dt>
          <dd class="mt-1 text-slate-900"><%= t("classrooms.index.grade", grade: @membership_grade) %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-500"><%= t("admin.teachers.form.classrooms_label") %></dt>
          <dd class="mt-1 text-slate-900"><%= classroom_display_name(@locked_classroom) %></dd>
        </div>
      </dl>
      <%= hidden_field_tag :school_id, @locked_classroom.school_year.school_id %>
      <%= hidden_field_tag :membership_grade, @membership_grade %>
      <%= hidden_field_tag :classroom_id, @locked_classroom.id %>
    <% elsif current_user.admin? %>
      <div>
        <%= label_tag :school_id, t("admin.teachers.form.school_label"), class: "block text-sm font-medium" %>
        <%= select_tag :school_id,
              options_from_collection_for_select(@schools, :id, :name, @selected_school_id),
              include_blank: t("admin.teachers.form.school_unspecified"),
              class: "mt-1 block w-full rounded border px-3 py-2",
              data: {
                teacher_classroom_picker_target: "school",
                action: "teacher-classroom-picker#changeSchool"
              } %>
      </div>
    <% else %>
      <p class="text-sm font-semibold text-slate-700"><%= @schools.first.name %></p>
      <%= tag.input type: "hidden",
            value: @selected_school_id,
            data: { teacher_classroom_picker_target: "school" } %>
    <% end %>
    <% unless @locked_classroom %>
      <div>
        <%= label_tag :membership_grade,
              t("filters.grade.label"),
              class: "block text-sm font-medium" %>
        <%= select_tag :membership_grade,
              options_for_select(
                (1..6).map { |grade| [t("classrooms.index.grade", grade: grade), grade] },
                @membership_grade
              ),
              include_blank: t("admin.teachers.index.unassigned_grade"),
              class: "mt-1 block w-full rounded border px-3 py-2",
              data: (@planning_teacher_creation ? {} : {
                teacher_classroom_picker_target: "grade",
                action: "teacher-classroom-picker#changeGrade"
              }) %>
      </div>

      <% unless @planning_teacher_creation %>
        <fieldset class="space-y-3">
          <legend class="font-semibold"><%= t("admin.teachers.form.classrooms_label") %></legend>
          <div data-teacher-classroom-picker-target="options">
            <%= render "teachers/classroom_options",
                  classrooms: @classroom_candidates,
                  selected_classroom_id: @selected_classroom_id,
                  selection_ready: @classroom_selection_ready,
                  selection_prompt_key: @classroom_selection_prompt_key %>
          </div>
        </fieldset>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5"
           data-teacher-form-section="profile">
    <h2 class="text-lg font-bold text-slate-900"><%= t("admin.teachers.info_title") %></h2>

    <div>
      <%= f.label :name, t("ui.user_labels.name"), class: "block text-sm font-medium" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded border px-3 py-2" %>
    </div>

    <div>
      <%= f.label :email, t("ui.user_labels.email"), class: "block text-sm font-medium" %>
      <%= f.email_field :email, class: "mt-1 block w-full rounded border px-3 py-2" %>
    </div>

    <% unless @teacher.persisted? %>
      <div>
        <%= f.label :login_id, t("users.teacher_sessions.login_id"), class: "block text-sm font-medium" %>
        <%= f.text_field :login_id, class: "mt-1 block w-full rounded border px-3 py-2" %>
      </div>
    <% end %>

    <div>
      <%= f.label :gender, t("admin.teachers.form.gender_label"), class: "block text-sm font-medium" %>
      <%= f.select :gender,
            [[t("admin.teachers.form.gender_male"), "male"], [t("admin.teachers.form.gender_female"), "female"]],
            { include_blank: t("admin.teachers.form.gender_prompt") },
            class: "mt-1 block w-full rounded border px-3 py-2",
            data: {
              action: "teacher-avatar-preview#update",
              teacher_avatar_preview_target: "gender"
            } %>
    </div>

    <%= f.hidden_field :avatar_key, data: { teacher_avatar_preview_target: "avatarKey" } %>
    <div data-teacher-avatar-preview-target="avatarSection"
         <%= "hidden" unless User.avatar_keys_for(@teacher.gender).include?(@teacher.avatar_key) %>>
      <div class="flex items-center gap-3">
        <%= user_avatar_image(
              @teacher,
              size: 128,
              class: "h-20 w-20 rounded-xl object-cover",
              alt: "#{display_name(@teacher)} avatar",
              data: { teacher_avatar_preview_target: "image" }
            ) %>
        <button type="button"
                class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold"
                aria-expanded="false"
                data-action="teacher-avatar-preview#togglePicker">
          <%= t("admin.teachers.form.avatar_select") %>
        </button>
      </div>

      <div hidden
           class="mt-3 grid grid-cols-6 gap-2"
           data-teacher-avatar-preview-target="picker">
        <% teacher_avatar_keys.each do |avatar_key| %>
          <button type="button"
                  class="relative cursor-pointer rounded border p-2"
                  aria-pressed="false"
                  data-avatar-key="<%= avatar_key %>"
                  data-action="teacher-avatar-preview#select"
                  data-teacher-avatar-preview-target="option">
            <%= image_tag "avatars/#{avatar_key}.png",
                  class: "h-12 w-12 rounded-lg object-cover",
                  alt: avatar_key %>
            <span hidden data-teacher-avatar-preview-target="check">✓</span>
          </button>
        <% end %>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-4">
      <%= f.submit t("ui.save"),
            class: "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white" %>
    </div>
  </section>
<% end %>
