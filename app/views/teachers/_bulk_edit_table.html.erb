<div class="mt-5 space-y-4"
     data-controller="teacher-bulk"
     data-teacher-bulk-count-label-value="<%= t('admin.teachers.bulk.count', count: '%{count}') %>"
     data-teacher-bulk-selection-label-value="<%= t('admin.teachers.bulk.selection_count', count: '%{count}') %>">
  <%= form_with url: bulk_update_admin_teachers_path(@bulk_context_params), method: :patch,
        id: "teacher_bulk_update", data: { turbo_frame: "_top" } do %>
    <%= hidden_field_tag :grade, @grade %>
    <% if @bulk_entries.any? %>
      <div class="overflow-x-auto rounded-md border border-stone-200">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
          <thead class="bg-stone-50">
            <tr>
              <th class="w-14 p-3 text-left"><%= check_box_tag :select_all_teachers, "1", false, aria: { label: t("admin.teachers.bulk.select_all") }, data: { teacher_bulk_target: "selectAll", action: "change->teacher-bulk#toggleAll" } %></th>
              <th class="p-3 text-left"><%= t("ui.user_labels.name") %></th>
              <th class="p-3 text-left"><%= t("users.teacher_sessions.login_id") %></th>
              <th class="p-3 text-left"><%= t("filters.grade.label") %></th>
              <th class="p-3 text-left"><%= t("admin.teachers.form.classrooms_label") %></th>
              <th class="p-3 text-left"><%= t("teacher_status.filter_label") %></th>
              <th class="p-3 text-left"><%= t("admin.teachers.bulk.password") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% @bulk_entries.each_with_index do |entry, index| %>
              <% value = ->(key) { entry.respond_to?(key) ? entry.public_send(key) : entry[key] || entry[key.to_s] } %>
              <% teacher = value.call(:user) %>
              <% entry_errors = value.call(:errors) || [] %>
              <% assignment_locked = teacher.assigned_classroom&.inactive? %>
              <tr id="<%= dom_id(teacher, :bulk_edit_row) %>" class="<%= 'bg-stone-50 text-stone-400' unless teacher.active? %>" data-teacher-bulk-target="row">
                <td class="w-14 p-3 align-middle"><%= check_box_tag "teacher_ids[]", teacher.id, false, form: "teacher_selection_operation", aria: { label: t("admin.teachers.bulk.select_teacher", name: teacher.name) }, data: { teacher_bulk_target: "selection", grade_eligible: teacher.active? && teacher.assigned_classroom.nil?, action: "change->teacher-bulk#updateSelection" } %></td>
                <td class="p-3 align-middle">
                  <%= hidden_field_tag "teachers[rows][#{index}][id]", teacher.id, disabled: !teacher.active? %>
                  <div class="flex items-center gap-2">
                    <%= user_avatar_image(
                          teacher,
                          size: 64,
                          class: "h-8 w-8 shrink-0 rounded-lg object-cover",
                          alt: "#{display_name(teacher)} avatar"
                        ) %>
                    <%= text_field_tag "teachers[rows][#{index}][name]",
                          value.call(:name),
                          class: "w-36 rounded-md border border-stone-400 bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700 disabled:cursor-not-allowed disabled:bg-stone-100 disabled:text-stone-400",
                          required: true,
                          disabled: !teacher.active?,
                          data: { action: "input->teacher-bulk#track" } %>
                  </div>
                </td>
                <td class="p-3 align-middle"><%= text_field_tag "teachers[rows][#{index}][login_id]", value.call(:login_id), class: "w-36 rounded-md border border-stone-400 bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700 disabled:cursor-not-allowed disabled:bg-stone-100 disabled:text-stone-400", required: true, disabled: !teacher.active?, data: { action: "input->teacher-bulk#track" } %></td>
                <td class="p-3 align-middle">
                  <%= hidden_field_tag "teachers[rows][#{index}][grade]", value.call(:grade) if teacher.active? && assignment_locked %>
                  <%= select_tag "teachers[rows][#{index}][grade]", options_for_select([[t("admin.teachers.index.unassigned_grade"), ""], *1.upto(6).map { |grade| [t("classrooms.index.grade", grade: grade), grade] }], value.call(:grade)), disabled: !teacher.active? || assignment_locked, class: "rounded-md border border-stone-300 bg-white px-3 py-2 focus:border-stone-700 focus:ring-stone-700 disabled:cursor-not-allowed disabled:bg-stone-100 disabled:text-stone-400", data: { teacher_bulk_target: "grade", action: "change->teacher-bulk#filter" } %>
                </td>
                <td class="p-3 align-middle">
                  <%= hidden_field_tag "teachers[rows][#{index}][classroom_id]", value.call(:classroom_id) if teacher.active? && assignment_locked %>
                  <select name="teachers[rows][<%= index %>][classroom_id]" <%= "disabled" if !teacher.active? || assignment_locked %> class="min-w-32 rounded-md border border-stone-300 bg-white px-3 py-2 focus:border-stone-700 focus:ring-stone-700 disabled:cursor-not-allowed disabled:bg-stone-100 disabled:text-stone-400" data-teacher-bulk-target="classroom" data-action="change->teacher-bulk#track">
                    <option value=""><%= t("admin.teachers.index.unassigned_grade") %></option>
                    <% @teacher_classrooms.each do |classroom| %>
                      <option value="<%= classroom.id %>" data-grade="<%= classroom.grade %>" <%= "selected" if classroom.id.to_s == value.call(:classroom_id).to_s %>><%= classroom_display_name(classroom) %><%= " (#{t('admin.teachers.form.inactive_classroom')})" if classroom.inactive? %></option>
                    <% end %>
                  </select>
                  <% if entry_errors.any? %><p class="mt-1 max-w-xs text-xs text-rose-700"><%= entry_errors.to_sentence %></p><% end %>
                </td>
                <td class="p-3 align-middle"><%= render "teachers/bulk_status", teacher: teacher %></td>
                <td class="p-3 align-middle"><%= render "teachers/bulk_password_action", teacher: teacher %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rounded-md border border-stone-200 py-10 text-center text-sm text-stone-500"><%= t("admin.teachers.index.empty") %></div>
    <% end %>
  <% end %>

  <%= form_with url: bulk_operation_admin_teachers_path(@bulk_context_params), method: :patch,
        id: "teacher_selection_operation", class: "flex flex-wrap items-center justify-between gap-3 rounded-md border border-stone-200 bg-stone-50 p-3", data: { turbo_frame: "_top" } do %>
    <%= hidden_field_tag :management_grade, @grade %>
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-sm text-stone-500" data-teacher-bulk-target="selectionCount"><%= t("admin.teachers.bulk.selection_count", count: 0) %></span>
      <div class="flex items-center gap-2 border-l border-stone-300 pl-3">
        <%= label_tag :grade, t("filters.grade.label"), class: "text-xs font-medium text-stone-600" %>
        <%= select_tag :grade, options_for_select([[t("admin.teachers.index.unassigned_grade"), ""], *1.upto(6).map { |grade| [t("classrooms.index.grade", grade: grade), grade] }]), class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm" %>
        <%= button_tag t("admin.teachers.bulk.assign"), name: :operation, value: "assign_grade", disabled: true, class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-50", data: { teacher_bulk_target: "gradeSubmit", turbo_confirm: t("admin.teachers.bulk.confirm_assign_grade") } %>
      </div>
      <div class="flex items-center gap-2 border-l border-stone-300 pl-3">
        <span class="text-xs font-medium text-stone-600"><%= t("admin.teachers.bulk.account_status") %></span>
        <%= button_tag t("teacher_status.reactivate"), name: :operation, value: "activate", disabled: true, class: "rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-800 hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50", data: { teacher_bulk_target: "operationSubmit" } %>
        <%= button_tag t("teacher_status.deactivate"), name: :operation, value: "deactivate", disabled: true, class: "rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-50", data: { teacher_bulk_target: "operationSubmit", turbo_confirm: t("admin.teachers.bulk.confirm_deactivate") } %>
      </div>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <%= link_to t("admin.teachers.index.add_teacher"), new_teacher_path(@bulk_context_params.merge(management_source: "admin")), class: "rounded-md border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-100", data: { turbo_frame: "_top" } %>
      <%= link_to t("admin.teachers.bulk.add_many"), bulk_setup_admin_teachers_path(@bulk_context_params.merge(grade: @grade == "all" ? nil : @grade)), class: "rounded-md border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-100", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>

  <% if @bulk_entries.any? %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="hidden text-xs text-rose-700" data-teacher-bulk-target="gradeReason"><%= t("admin.teachers.bulk.grade_reason") %></span>
      <% if @bulk_entries.any? { |entry| (entry.respond_to?(:user) ? entry.user : entry[:user]).active? } %>
        <%= button_tag t("admin.teachers.bulk.save_changes"), type: :submit, form: "teacher_bulk_update", class: "ml-auto rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-50" %>
      <% end %>
    </div>
  <% end %>
</div>
