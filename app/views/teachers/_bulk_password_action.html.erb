<div id="<%= dom_id(teacher, :bulk_password_action) %>">
  <% permissions = @bulk_permissions.fetch(teacher.id) %>
  <% if permissions[:reissue] %>
    <%= link_to t("admin.teachers.bulk.reissue"), temporary_password_admin_teacher_path(teacher, @bulk_context_params), class: "text-sm font-medium underline", data: { turbo_frame: "temporary_password_modal" } %>
  <% elsif permissions[:destroy] %>
    <%= link_to t("ui.buttons.delete"), admin_teacher_path(teacher, @bulk_context_params), class: "text-sm font-medium text-rose-700 underline", data: { turbo_method: :delete, turbo_confirm: t("admin.teachers.bulk.confirm_delete", name: teacher.name, login_id: teacher.login_id) } %>
  <% else %>
    <span aria-hidden="true">—</span>
  <% end %>
</div>
