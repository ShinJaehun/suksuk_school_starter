<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<section class="mx-auto max-w-xl space-y-6 pt-4">
  <header class="space-y-2">
    <h1 class="text-3xl font-extrabold"><%= t("admin.teachers.temporary_password_reissue.result_title") %></h1>
    <p class="text-sm text-slate-600"><%= t("admin.teachers.temporary_password_reissue.one_time_notice") %></p>
  </header>

  <dl class="space-y-4 rounded-xl border border-amber-200 bg-amber-50 p-5">
    <div>
      <dt class="text-sm font-semibold text-amber-800"><%= t("admin.teachers.temporary_password_reissue.teacher_name") %></dt>
      <dd class="mt-1 font-bold text-amber-950"><%= @teacher.name %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-amber-800"><%= t("admin.teachers.temporary_password_reissue.login_id") %></dt>
      <dd class="mt-1 font-mono text-lg font-bold text-amber-950"><%= @teacher.login_id %></dd>
    </div>
    <div>
      <dt class="text-sm font-semibold text-amber-800"><%= t("admin.teachers.temporary_password_reissue.temporary_password") %></dt>
      <dd data-temporary-password class="mt-1 break-all font-mono text-xl font-extrabold text-amber-950"><%= @temporary_password %></dd>
    </div>
  </dl>

  <%= link_to t(@teacher_context_return_path ?
                  "admin.teachers.temporary_password_reissue.back_to_context" :
                  "admin.teachers.temporary_password_reissue.back_to_teacher"),
        @teacher_context_return_path || edit_teacher_path(@teacher),
        class: "inline-flex rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
</section>
