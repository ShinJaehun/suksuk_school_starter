<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>

<div class="mx-auto max-w-4xl space-y-6"
     data-controller="credential-list"
     data-credential-list-return-url-value="<%= @credentials_return_path %>"
     data-credential-list-header-value="<%= t('admin.teachers.bulk.credentials_copy_header') %>"
     data-credential-list-copied-value="<%= t('admin.teachers.bulk.copied') %>">
  <div>
    <h1 class="text-3xl font-semibold"><%= @credentials_title %></h1>
    <p class="mt-2 text-sm text-rose-700"><%= t("admin.teachers.bulk.credentials_warning") %></p>
  </div>
  <div class="flex flex-wrap gap-2 print:hidden">
    <button type="button" class="rounded-md border border-stone-300 px-3 py-2 text-sm font-medium" data-action="credential-list#copyAll"><%= t("admin.teachers.bulk.copy_all") %></button>
    <button type="button" class="rounded-md border border-stone-300 px-3 py-2 text-sm font-medium" data-action="credential-list#print"><%= t("admin.teachers.bulk.print") %></button>
  </div>
  <div class="overflow-x-auto rounded-md border border-stone-200">
    <table class="min-w-full divide-y divide-stone-200 text-sm">
      <thead class="bg-stone-50"><tr><th class="p-3 text-left"><%= t("ui.user_labels.name") %></th><th class="p-3 text-left"><%= t("users.teacher_sessions.login_id") %></th><th class="p-3 text-left"><%= t("admin.teachers.bulk.temporary_password") %></th><th class="p-3 text-left print:hidden"><%= t("admin.teachers.bulk.copy") %></th></tr></thead>
      <tbody class="divide-y divide-stone-100">
        <% @credentials.each do |credential| %>
          <tr data-credential-list-target="row" data-copy-text="<%= [credential[:name], credential[:login_id], credential[:temporary_password]].join("\t") %>">
            <td class="p-3"><%= credential[:name] %></td><td class="p-3 font-mono"><%= credential[:login_id] %></td><td class="p-3 font-mono font-semibold"><%= credential[:temporary_password] %></td>
            <td class="p-3 print:hidden"><button type="button" class="text-sm font-medium underline" data-action="credential-list#copyRow"><%= t("admin.teachers.bulk.copy") %></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= link_to t("admin.teachers.bulk.return_to_management"), @credentials_return_path, class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white print:hidden" %>
</div>
