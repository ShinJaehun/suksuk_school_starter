<section class="mx-auto w-full max-w-6xl pt-4">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900"><%= t("admin.teachers.index.title") %></h1>
      <% if @selected_school_year %>
        <p class="mt-1 text-sm font-semibold text-slate-600">
          <%= t(
                "admin.teachers.index.context_title",
                year: @selected_school_year.year,
                status: t("school_years.status.#{@selected_school_year.status}")
              ) %>
        </p>
        <% unless @teacher_context_mutable %>
          <p class="mt-1 text-sm text-amber-700"><%= t("admin.teachers.index.context_read_only") %></p>
        <% end %>
      <% end %>
      <% if current_user.admin? %>
        <%= form_with url: teachers_path, method: :get, class: "mt-3 flex flex-wrap items-end gap-2" do %>
          <div>
            <%= label_tag :school_id, t("filters.school.label"), class: "block text-xs font-semibold text-slate-500" %>
            <%= select_tag :school_id,
                  options_for_select([[t("filters.school.all"), ""]] + @filter_schools.map { |school| [school.name, school.id] }, @selected_school&.id),
                  class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <%= submit_tag t("filters.apply"), class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %>
        <% end %>
      <% end %>
      <%= form_with url: teachers_path, method: :get, class: "mt-3 flex flex-wrap items-end gap-2" do %>
        <%= hidden_field_tag :school_id, @selected_school.id if @selected_school %>
        <% if @show_school_year_selector && @selected_school %>
          <div>
            <%= label_tag :school_year_id, t("admin.teachers.index.school_year"), class: "block text-xs font-semibold text-slate-500" %>
            <%= select_tag :school_year_id,
                  options_for_select(
                    @school_year_options.map do |school_year|
                      [
                        t(
                          "admin.teachers.index.school_year_option",
                          year: school_year.year,
                          status: t("school_years.status.#{school_year.status}")
                        ),
                        school_year.id
                      ]
                    end,
                    @selected_school_year&.id
                  ),
                  class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          </div>
        <% end %>
        <div>
          <%= label_tag :status, t("teacher_status.filter_label"), class: "block text-xs font-semibold text-slate-500" %>
          <%= select_tag :status,
                options_for_select([[t("teacher_status.active"), "active"], [t("teacher_status.inactive"), "inactive"], [t("teacher_status.all"), "all"]], @teacher_status),
                class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <%= submit_tag t("filters.apply"), class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" %>
      <% end %>
    </div>
    <% if @teacher_context_creatable %>
      <%= link_to t("admin.teachers.index.add_teacher"), @new_teacher_path,
            class: "rounded-lg bg-emerald-600 px-4 py-2 text-center text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <div class="divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <% if @teacher_rows.any? %>
      <% @teacher_rows.each do |row| %>
        <% teacher = row[:teacher] %>
        <article class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 items-center gap-3">
            <%= user_avatar_image(teacher, size: 128, class: "h-10 w-10 rounded-xl object-cover", alt: "#{display_name(teacher)} avatar") %>
            <div>
              <p class="font-semibold text-slate-900"><%= display_name(teacher) %></p>
              <p class="text-xs text-slate-500"><%= teacher.email %></p>
              <p class="text-xs text-slate-500"><%= row[:school]&.name %> · <%= t(row[:role] == "manager" ? "admin.teachers.index.manager" : "admin.teachers.index.member") %></p>
              <p class="text-xs text-slate-500">
                <%= t("admin.teachers.index.membership_grade") %>:
                <% if row[:membership_grade] %>
                  <%= t("classrooms.index.grade", grade: row[:membership_grade]) %>
                <% else %>
                  <%= t("admin.teachers.index.unassigned_grade") %>
                <% end %>
              </p>
              <p class="text-xs text-slate-500">
                <%= row[:classroom] ? classroom_display_name(row[:classroom]) : t("admin.teachers.index.unassigned_grade") %>
              </p>
            </div>
          </div>
          <% if row[:manageable] %>
            <%= link_to t("admin.teachers.index.manage"), edit_teacher_path(teacher), class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold" %>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <p class="px-5 py-10 text-center text-sm text-slate-500"><%= t("admin.teachers.index.empty") %></p>
    <% end %>
  </div>
</section>
