<%= turbo_frame_tag dom_id(student) do %>
  <div class="h-full rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" data-student-card data-student-id="<%= student.id %>">
    <div class="flex items-center gap-3">
      <%= student_avatar_image(student, size: 128, class: "h-10 w-10 shrink-0 rounded-lg border border-slate-200 bg-slate-100 object-cover", alt: "#{student.name} avatar") %>
      <div class="min-w-0">
        <div class="text-xs font-medium text-slate-500" data-student-number>
          <%= student.student_number.present? ? t("students.roster.student_number_value", number: student.student_number) : t("students.roster.unassigned_student_number") %>
        </div>
        <%= link_to student.name, classroom_student_path(classroom, student), data: { turbo: false }, class: "font-semibold text-sky-700 hover:underline" %>
      </div>
    </div>
  </div>
<% end %>
