<section class="mx-auto w-full max-w-6xl py-6">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900"><%= t("schools.index.title") %></h1>
    <% if current_user.admin? %>
      <div class="flex flex-wrap justify-end gap-2">
        <%= link_to t("classrooms.index.add_school"), new_admin_school_path, data: { turbo_frame: "modal" }, class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      </div>
    <% end %>
  </div>

  <% if current_user.admin? %>
    <%= form_with url: schools_path, method: :get,
          class: "mt-4 flex flex-wrap items-end gap-2 rounded-xl border border-slate-200 bg-white p-4",
          data: { management_filter_panel: true } do %>
      <div>
        <%= label_tag :status, t("school_status.filter_label"), class: "block text-xs font-semibold text-slate-500" %>
        <%= select_tag :status,
              options_for_select([
                [t("school_status.active"), "active"],
                [t("school_status.inactive"), "inactive"],
                [t("school_status.all"), "all"]
              ], @school_status),
              class: "mt-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
      </div>
      <%= submit_tag t("filters.apply"), class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
    <% end %>
  <% end %>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <% @schools.each do |school| %>
      <article class="rounded-2xl border p-5 shadow-sm <%= school_color_card_class(school.color_key) %>">
        <div class="flex items-start justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2">
            <span aria-hidden="true" class="h-3 w-3 shrink-0 rounded-full <%= school_color_swatch_class(school.color_key) %>"></span>
            <h2 class="truncate text-xl font-bold text-slate-900"><%= school.name %></h2>
            <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= school.active? ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600" %>"><%= t(school.active? ? "school_status.active" : "school_status.inactive") %></span>
          </div>
        </div>
        <p class="mt-3 text-sm text-slate-600"><%= t("schools.index.summary", classrooms: @classroom_counts.fetch(school.id, 0), teachers: @teacher_counts.fetch(school.id, 0)) %></p>
        <p class="mt-1 text-sm text-slate-600"><%= t("schools.index.administrators", names: @managers_by_school_id.fetch(school.id, []).map { |manager| display_name(manager) }.presence&.join(", ") || t("schools.index.administrators_empty")) %></p>
        <%= link_to t("schools.index.open"), school_path(school), class: "mt-4 inline-flex rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
      </article>
    <% end %>
  </div>
</section>
