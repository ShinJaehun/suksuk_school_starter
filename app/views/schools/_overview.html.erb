<%= turbo_frame_tag "school_overview", target: "_top" do %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold text-sky-700"><%= t("schools.show.operations_title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-900"><%= school.name %></h1>
      <span class="mt-2 inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= school.active? ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600" %>"><%= t(school.active? ? "school_status.active" : "school_status.inactive") %></span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to t("schools.show.back_to_classrooms"), classrooms_path(school_id: school.id),
            class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <% if policy(school).update? %>
        <%= link_to t("schools.settings.title"),
              edit_school_path(school),
              class: "inline-flex items-center justify-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <dt class="text-sm text-slate-500"><%= t("schools.show.classroom_count") %></dt>
      <dd class="mt-2 text-2xl font-bold text-slate-900"><%= t("schools.show.classroom_count_value", count: classroom_count) %></dd>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <dt class="text-sm text-slate-500"><%= t("schools.show.teacher_count") %></dt>
      <dd class="mt-2 text-2xl font-bold text-slate-900"><%= t("schools.show.teacher_count_value", count: teacher_count) %></dd>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <dt class="text-sm text-slate-500"><%= t("schools.show.administrators") %></dt>
      <dd class="mt-2">
        <% if managers.any? %>
          <div class="space-y-2">
            <% managers.each do |manager| %>
              <%= render "schools/manager_identity", user: manager %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm font-semibold text-slate-900"><%= t("schools.show.administrators_empty") %></p>
        <% end %>
      </dd>
    </div>
  </dl>

  <% if can_manage_planning_school_year %>
    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-lg font-bold text-slate-900"><%= t("school_years.planning.title") %></h2>
          <% if planning_school_year %>
            <p class="mt-1 text-sm text-slate-600">
              <%= t("school_years.planning.existing", year: planning_school_year.year) %>
            </p>
          <% else %>
            <p class="mt-1 text-sm text-slate-600">
              <%= t("school_years.planning.next", current_year: active_school_year.year, next_year: next_planning_year) %>
            </p>
          <% end %>
        </div>
        <% unless planning_school_year %>
          <%= button_to t("school_years.planning.start", year: next_planning_year),
                school_school_years_path(school),
                method: :post,
                class: "inline-flex items-center justify-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
        <% end %>
      </div>

      <% if planning_preparation_summary %>
        <%= render "schools/planning_preparation",
              summary: planning_preparation_summary,
              planning_teacher_path: planning_teacher_path %>
      <% end %>
    </section>
  <% end %>
<% end %>
