<%= form_with model: classroom, local: true do |f| %>
  <% if @classroom_creation_context_explicit && @classroom_creation_school_year %>
    <%= hidden_field_tag :school_id, @classroom_creation_school_year.school_id %>
    <%= hidden_field_tag :school_year_id, @classroom_creation_school_year.id %>
  <% end %>

  <div class="space-y-6">
    <% if classroom.errors[:base].any? %>
      <div class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">
        <%= classroom.errors.full_messages_for(:base).to_sentence %>
      </div>
    <% end %>

    <% if @classroom_creation_structure_allowed || policy(classroom).manage_structure? %>
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-4">
          <h2 class="text-base font-semibold text-slate-900"><%= t("classrooms.form.basic_info") %></h2>
        </div>

        <div class="space-y-2 sm:max-w-3xl">
          <% class_label_has_errors = classroom.errors[:class_label].any? %>
          <%= f.label :class_label, t("classrooms.form.class_label_label"), class: "block text-sm font-semibold text-slate-800" %>
          <%= f.text_field :class_label,
                placeholder: t("classrooms.form.class_label_placeholder"),
                class: "block w-full rounded-xl border px-4 py-3 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 #{class_label_has_errors ? "border-rose-400 focus:border-rose-500 focus:ring-rose-100" : "border-slate-300 focus:border-sky-500 focus:ring-sky-100"}" %>
          <% if class_label_has_errors %>
            <p class="text-sm text-rose-600"><%= classroom.errors.full_messages_for(:class_label).to_sentence %></p>
          <% else %>
            <p class="text-sm text-slate-500"><%= t("classrooms.form.class_label_hint") %></p>
          <% end %>
        </div>

        <div class="mt-5 grid gap-4 sm:max-w-3xl sm:grid-cols-2">
          <% if current_user.admin? && classroom.new_record? && !@classroom_creation_context_explicit %>
            <div class="space-y-2">
              <% school_has_errors = classroom.errors[:school_year].any? %>
              <%= label_tag "classroom_school_id", t("classrooms.form.school_label"), class: "block text-sm font-semibold text-slate-800" %>
              <%= select_tag "classroom[school_id]",
                    options_from_collection_for_select(@school_options, :id, :name, @selected_classroom_school&.id),
                    include_blank: t("classrooms.form.school_prompt"),
                    class: "block w-full rounded-xl border px-4 py-3 text-sm text-slate-900 shadow-sm focus:outline-none focus:ring-2 #{school_has_errors ? "border-rose-400 focus:border-rose-500 focus:ring-rose-100" : "border-slate-300 focus:border-sky-500 focus:ring-sky-100"}" %>
              <% if school_has_errors %>
                <p class="text-sm text-rose-600"><%= classroom.errors.full_messages_for(:school_year).to_sentence %></p>
              <% end %>
            </div>
          <% elsif classroom.persisted? || @classroom_creation_school_year || current_user.school_manager? %>
            <div class="space-y-2">
              <span class="block text-sm font-semibold text-slate-800"><%= t("classrooms.form.school_label") %></span>
              <p class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700"><%= classroom.school_year.school.name %></p>
              <% if classroom.errors[:school_year].any? %>
                <p class="text-sm text-rose-600"><%= classroom.errors.full_messages_for(:school_year).to_sentence %></p>
              <% end %>
            </div>
          <% end %>

          <div class="space-y-2">
            <% grade_has_errors = classroom.errors[:grade].any? %>
            <%= f.label :grade, t("classrooms.form.grade_label"), class: "block text-sm font-semibold text-slate-800" %>
            <%= f.select :grade,
                  (1..6).map { |grade| [t("classrooms.index.grade", grade: grade), grade] },
                  { include_blank: t("classrooms.form.grade_prompt") },
                  class: "block w-full rounded-xl border px-4 py-3 text-sm text-slate-900 shadow-sm focus:outline-none focus:ring-2 #{grade_has_errors ? "border-rose-400 focus:border-rose-500 focus:ring-rose-100" : "border-slate-300 focus:border-sky-500 focus:ring-sky-100"}" %>
            <% if grade_has_errors %>
              <p class="text-sm text-rose-600"><%= classroom.errors.full_messages_for(:grade).to_sentence %></p>
            <% end %>
          </div>
        </div>
      </section>

    <% end %>

    <div class="flex justify-end">
      <%= f.submit submit_label,
            class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>
  </div>
<% end %>
