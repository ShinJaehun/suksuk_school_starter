<section class="mx-auto w-full max-w-6xl pt-4">
  <div class="mb-6 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
    <div class="flex flex-col gap-3">
      <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= @classrooms_index_title %></h1>
      <% if @selected_school_year %>
        <p class="text-sm font-semibold text-slate-600">
          <%= t(
                "classrooms.index.context_title",
                year: @selected_school_year.year,
                status: t("school_years.status.#{@selected_school_year.status}")
              ) %>
        </p>
        <% if @classroom_context_read_only %>
          <p class="text-sm text-amber-700"><%= t("classrooms.index.context_read_only") %></p>
        <% end %>
      <% end %>

      <% if current_user.admin? %>
        <%= form_with url: classrooms_path,
              method: :get,
              id: "classroom-school-filter",
              class: "flex flex-wrap items-end gap-2" do %>
          <div>
            <%= label_tag :school_id, t("filters.school.label"), class: "block text-xs font-semibold text-slate-500" %>
            <%= select_tag :school_id,
                  options_for_select(
                    [[t("filters.school.all"), ""]] + @filter_schools.map { |school| [school.name, school.id] },
                    @selected_school&.id
                  ),
                  class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <%= submit_tag t("filters.apply"),
                class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
        <% end %>
      <% end %>

      <%= form_with url: classrooms_path,
            method: :get,
            id: "classroom-grade-filter",
            class: "flex flex-wrap items-end gap-2" do %>
        <%= hidden_field_tag :school_id, @selected_school.id if @selected_school %>
        <% if @show_school_year_selector && @selected_school %>
          <div>
            <%= label_tag :school_year_id, t("classrooms.index.school_year"), class: "block text-xs font-semibold text-slate-500" %>
            <%= select_tag :school_year_id,
                  options_for_select(
                    @school_year_options.map do |school_year|
                      [
                        t(
                          "classrooms.index.school_year_option",
                          year: school_year.year,
                          status: t("school_years.status.#{school_year.status}")
                        ),
                        school_year.id
                      ]
                    end,
                    @selected_school_year&.id
                  ),
                  class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          </div>
        <% end %>

        <div>
          <%= label_tag :grade, t("filters.grade.label"), class: "block text-xs font-semibold text-slate-500" %>
          <%= select_tag :grade,
                options_for_select(
                  [[t("filters.grade.all"), ""]] +
                    (1..6).map { |grade| [t("classrooms.index.grade", grade: grade), grade] },
                  @selected_grade
                ),
                class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <%= submit_tag t("filters.apply"),
              class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <% end %>
    </div>

    <% if @classroom_context_creatable %>
      <%= link_to t('ui.buttons.new_classroom'),
            @new_classroom_path,
            class: "inline-flex w-full justify-center items-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700 sm:w-auto" %>
    <% end %>
  </div>

  <% if @classrooms.any? %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @classrooms.each do |classroom| %>
        <% teacher = @classroom_teachers[classroom.id] %>
        <% student_count = @classroom_student_counts.fetch(classroom.id, 0) %>
        <% student_previews = @classroom_student_previews.fetch(classroom.id, []) %>

        <article class="flex min-h-64 flex-col justify-between rounded-2xl border p-5 shadow-sm <%= school_color_card_class(classroom.school_year.school.color_key) %>">
          <div class="min-w-0 space-y-5">
            <div>
              <p class="flex items-center gap-1.5 truncate text-xs font-semibold text-slate-500">
                <span aria-hidden="true" class="h-2.5 w-2.5 shrink-0 rounded-full <%= school_color_swatch_class(classroom.school_year.school.color_key) %>"></span>
                <span class="truncate"><%= classroom.school_year.school.name %></span>
              </p>
              <h2 class="mt-1 truncate text-lg font-bold text-slate-900"><%= classroom_display_name(classroom) %></h2>
              <% unless @selected_school_year&.planning? %>
                <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= classroom.active? ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600" %>">
                  <%= t(classroom.active? ? "classroom_status.active" : "classroom_status.inactive") %>
                </span>
              <% end %>
            </div>

            <div class="space-y-3">
              <% if teacher %>
                <div class="flex min-w-0 items-center gap-2">
                  <%= user_avatar_image(
                        teacher,
                        size: 128,
                        class: "h-10 w-10 shrink-0 rounded-xl border-2 border-white bg-slate-100 object-cover",
                        alt: "#{display_name(teacher)} avatar"
                      ) %>
                  <span class="min-w-0 truncate text-sm font-semibold text-slate-800"><%= display_name(teacher) %></span>
                </div>
              <% else %>
                <p class="text-sm text-slate-500"><%= t("classrooms.index.teacher_empty") %></p>
              <% end %>

              <% if student_count.positive? %>
                <div class="flex min-w-0 items-center gap-3">
                  <div class="flex max-w-32 shrink-0 -space-x-2 overflow-hidden">
                    <% student_previews.each do |student| %>
                      <%= student_avatar_image(
                            student,
                            size: 128,
                            class: "h-8 w-8 rounded-xl border-2 border-white bg-slate-100 object-cover",
                            alt: "#{display_name(student)} avatar"
                          ) %>
                    <% end %>
                  </div>
                  <span class="shrink-0 whitespace-nowrap text-sm font-medium text-slate-600"><%= t("classrooms.index.student_count", count: student_count) %></span>
                </div>
              <% else %>
                <p class="text-sm text-slate-500"><%= t("classrooms.index.student_empty") %></p>
              <% end %>
            </div>
          </div>

          <% unless @classroom_context_read_only %>
            <div class="mt-6 flex flex-wrap items-center gap-2">
              <%= link_to t("classrooms.index.open"),
                    classroom_path(classroom),
                    class: "inline-flex flex-1 items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
              <% if policy(classroom).manage_members? %>
                <%= link_to t("classrooms.show.manage_members"),
                      classroom_members_path(classroom),
                      class: "inline-flex flex-1 items-center justify-center rounded-lg border border-indigo-300 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-100" %>
              <% end %>
              <% if policy(classroom).edit? %>
                <%= link_to t("classrooms.actions.settings"),
                      edit_classroom_path(classroom, @classroom_edit_context_params),
                      class: "inline-flex flex-1 items-center justify-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
              <% end %>
            </div>
          <% end %>
          <% if @classroom_context_read_only %>
            <div class="mt-6 flex flex-wrap items-center gap-2">
              <% if policy(classroom).show? %>
                <%= link_to t("classrooms.index.open"),
                      classroom_path(classroom, @classroom_show_context_params),
                      class: "inline-flex flex-1 items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
              <% end %>
              <% if policy(classroom).edit? %>
                <%= link_to t("classrooms.actions.settings"),
                      edit_classroom_path(classroom, @classroom_edit_context_params),
                      class: "inline-flex flex-1 items-center justify-center rounded-lg border border-sky-300 bg-sky-50 px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="px-5 py-10 text-center text-sm text-slate-500">
        <%= t("classrooms.index.empty") %>
      </div>
    </div>
  <% end %>
</section>
