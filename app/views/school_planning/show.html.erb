<section class="mx-auto w-full max-w-5xl space-y-6 py-6">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold text-sky-700"><%= t("school_years.planning.title") %></p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-900"><%= @school.name %></h1>
      <p class="mt-2 text-sm font-semibold text-slate-600">
        <%= t("schools.planning.year_status", year: @planning_school_year.year) %>
      </p>
    </div>
    <%= link_to t("schools.planning.back_to_school"),
          school_path(@school),
          class: "inline-flex items-center justify-center self-start rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </header>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= render "schools/planning_preparation",
          summary: @planning_preparation_summary,
          planning_teacher_path: @planning_teacher_path,
          planning_classroom_path: @planning_classroom_path %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900"><%= t("schools.planning.rollover.title") %></h2>
    <% if @rollover_eligibility.eligible? %>
      <p class="mt-2 text-sm text-emerald-700"><%= t("schools.planning.rollover.manager_ready") %></p>
      <% if @can_rollover %>
        <%= button_to t("schools.planning.rollover.submit"),
              school_planning_rollover_path(@school),
              params: { school_year_id: @planning_school_year.id },
              method: :post,
              data: {
                turbo_confirm: t(
                  "schools.planning.rollover.confirm",
                  current_year: @school.active_school_year.year,
                  next_year: @planning_school_year.year,
                  manager: @rollover_eligibility.manager.name
                ),
                turbo_submits_with: t("ui.processing")
              },
              class: "mt-4 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm text-amber-700"><%= t("schools.planning.rollover.manager_required") %></p>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-bold text-slate-900"><%= t("schools.planning.manager_title") %></h2>
    <div class="mt-3 space-y-2">
      <% if @planning_managers.any? %>
        <% @planning_managers.each do |manager| %>
          <div class="flex items-center justify-between gap-3">
            <%= render "schools/manager_identity", user: manager %>
            <% if @can_manage_planning_manager %>
              <%= link_to t("schools.settings.manager_remove"),
                    admin_school_manager_path(
                      @school,
                      manager,
                      school_year_id: @planning_school_year.id
                    ),
                    data: { turbo_method: :delete, turbo_confirm: t("schools.settings.manager_remove_confirm") },
                    class: "text-sm font-semibold text-rose-700" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-500"><%= t("schools.planning.manager_empty") %></p>
      <% end %>
    </div>

    <% if @can_manage_planning_manager %>
      <%= form_with url: admin_school_school_managers_path(@school), class: "mt-4 space-y-3" do |form| %>
        <%= form.hidden_field :school_year_id, value: @planning_school_year.id %>
        <div>
          <%= form.label :user_id, t("schools.planning.manager_candidate_label"), class: "block text-sm font-semibold text-slate-800" %>
          <%= form.collection_select :user_id,
                @planning_manager_candidates,
                :id,
                :name,
                { prompt: t("schools.settings.manager_prompt") },
                { class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" } %>
        </div>
        <%= form.submit t("schools.settings.manager_assign"),
              data: { turbo_submits_with: t("ui.processing") },
              class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    <% end %>
  </section>
</section>
