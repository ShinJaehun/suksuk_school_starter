<%= turbo_frame_tag "temporary_password_modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-900/40 p-4"
       data-controller="temporary-password-modal"
       data-temporary-password-modal-copied-label-value="<%= t('admin.teachers.bulk.copied') %>"
       <% if @credential %>data-temporary-password-modal-copy-text-value="<%= [@credential[:name], @credential[:login_id], @credential[:temporary_password]].join("\t") %>"<% end %>>
    <section class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
      <% if @credential %>
        <h2 class="text-xl font-semibold"><%= t("admin.teachers.bulk.password_issued") %></h2>
        <p class="mt-2 text-sm text-rose-700"><%= t("admin.teachers.temporary_password_reissue.one_time_notice") %></p>
        <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
          <dt class="font-medium"><%= t("ui.user_labels.name") %></dt><dd><%= @credential[:name] %></dd>
          <dt class="font-medium"><%= t("admin.teachers.temporary_password_reissue.login_id") %></dt><dd class="font-mono"><%= @credential[:login_id] %></dd>
          <dt class="font-medium"><%= t("admin.teachers.temporary_password_reissue.temporary_password") %></dt><dd class="font-mono font-semibold"><%= @credential[:temporary_password] %></dd>
        </dl>
        <div class="mt-6 flex justify-end gap-2">
          <button type="button" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium" data-action="temporary-password-modal#copy"><%= t("admin.teachers.bulk.copy") %></button>
          <button type="button" class="rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" data-action="temporary-password-modal#close"><%= t("ui.buttons.close") %></button>
        </div>
      <% else %>
        <h2 class="text-xl font-semibold"><%= t("admin.teachers.temporary_password_reissue.title") %></h2>
        <p class="mt-3 font-medium"><%= @teacher.name %> (<%= @teacher.login_id %>)</p>
        <p class="mt-3 text-sm text-stone-600"><%= t("admin.teachers.temporary_password_reissue.description") %></p>
        <div class="mt-6 flex justify-end gap-2">
          <button type="button" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium" data-action="temporary-password-modal#close"><%= t("ui.cancel") %></button>
          <%= button_to t("admin.teachers.temporary_password_reissue.submit"),
                reissue_temporary_password_admin_teacher_path(@teacher, @bulk_context_params),
                method: :patch,
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
